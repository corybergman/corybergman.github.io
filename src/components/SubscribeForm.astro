---
// Email subscribe form.
// variant="inline" (homepage footer) | "card" (below a post)
// TODO: set `action` to your email provider's endpoint (Buttondown, Mailchimp, etc.).
interface Props {
	variant?: 'inline' | 'card';
}
const { variant = 'inline' } = Astro.props;
const ACTION = '#'; // replace with provider endpoint
---

<form class:list={['subscribe', variant]} action={ACTION} method="post">
	<span class="label">New posts by email</span>
	<label class="sr-only" for="sub-email">Email address</label>
	<input
		id="sub-email"
		type="email"
		name="email"
		placeholder="you@example.com"
		required
	/>
	<button type="submit">Subscribe</button>
</form>

<style>
	.subscribe {
		display: flex;
		gap: 14px;
		align-items: center;
		font-size: 14px;
		color: var(--muted);
	}
	.subscribe.inline {
		border-top: 1px solid var(--rule);
		padding-top: 30px;
	}
	.subscribe.card {
		background: var(--card-bg);
		border-radius: 6px;
		margin-top: 40px;
		padding: 24px 28px;
		color: var(--excerpt);
	}
	.label {
		flex-shrink: 0;
	}
	input {
		font-family: inherit;
		font-size: 14px;
		color: var(--body);
		background: #fff;
		border: 1px solid var(--outline);
		border-radius: 4px;
		padding: 8px 12px;
		flex: 1;
	}
	.subscribe.inline input {
		max-width: 240px;
	}
	input::placeholder {
		color: var(--faint);
	}
	button {
		font-family: inherit;
		font-size: 14px;
		font-weight: 500;
		color: #fff;
		background: var(--pine);
		border: none;
		border-radius: 4px;
		padding: 9px 16px;
		cursor: pointer;
		flex-shrink: 0;
	}
	button:hover {
		background: var(--pine-2);
	}

	@media (max-width: 700px) {
		.subscribe {
			flex-wrap: wrap;
		}
	}
</style>
