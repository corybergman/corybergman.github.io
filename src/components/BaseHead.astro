---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE, SOCIAL } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	// Override the canonical URL (e.g. a Medium original for republished posts).
	canonical?: string;
}

const { title, description, canonical } = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site);

// schema.org Person — lets AI/search read the site owner as an entity.
const personLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE_TITLE,
	url: Astro.site?.href ?? 'https://corybe.com/',
	jobTitle: 'Co-founder and Chief Product Officer',
	worksFor: {
		'@type': 'Organization',
		name: 'Factal',
		url: 'https://www.factal.com',
	},
	description:
		'Journalist and technologist working at the intersection of breaking news and AI.',
	sameAs: [SOCIAL.x, SOCIAL.bluesky, SOCIAL.threads, SOCIAL.linkedin],
});
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Google tag (gtag.js) -->
<script
	is:inline
	async
	src="https://www.googletagmanager.com/gtag/js?id=G-7S4QWH00Z4"></script>
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag() {
		dataLayer.push(arguments);
	}
	gtag('js', new Date());

	gtag('config', 'G-7S4QWH00Z4');
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-mono" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Structured data (schema.org Person) -->
<script type="application/ld+json" is:inline set:html={personLd} />
