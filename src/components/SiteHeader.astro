---
import { SITE_TITLE } from '../consts';

export type NavKey = 'home' | 'topics' | 'projects' | 'speaking' | 'about';

interface Props {
	active?: NavKey;
}
const { active } = Astro.props;

// Single source of truth for the nav. RSS is not here — it lives in the
// footer with the social links.
const links: Array<{ href: string; label: string; key: NavKey }> = [
	{ href: '/', label: 'Home', key: 'home' },
	{ href: '/tags/', label: 'Topics', key: 'topics' },
	{ href: '/projects', label: 'Projects', key: 'projects' },
	{ href: '/speaking', label: 'Speaking', key: 'speaking' },
	{ href: '/about', label: 'About', key: 'about' },
];
---

<!-- One header for every page (2026-09 home redesign): name on the left, nav
     on the right, no avatar. The home page's H1 now lives in its hero, so the
     name here is a plain link everywhere. -->
<header class="bar">
	<a href="/" class="name">{SITE_TITLE}</a>
	<nav class="nav">
		{
			links.map((link) => (
				<a href={link.href} class:list={[active === link.key && 'active']}>
					{link.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
		/* Spec is 18px above; .frame-body already contributes 8px. */
		padding: 10px 0 20px;
		border-bottom: 1px solid var(--rule);
	}
	.name {
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--ink);
	}
	.name:hover {
		color: var(--pine);
	}
	.nav {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		font-size: 14px;
		color: var(--muted);
	}
	.nav a:hover {
		color: var(--pine);
	}
	.nav a.active {
		color: var(--ink);
	}

	@media (max-width: 700px) {
		/* Five links won't fit a phone row at 14px — a small step down in size
		   and gap keeps them on one line at 375px wide. */
		.nav {
			font-size: 13px;
			gap: 14px 13px;
		}
	}
</style>
