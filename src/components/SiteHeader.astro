---
import { SITE_TITLE } from '../consts';
import Avatar from './Avatar.astro';

export type NavKey = 'home' | 'topics' | 'projects' | 'speaking' | 'about';

interface Props {
	variant?: 'home' | 'sub';
	active?: NavKey;
}
const { variant = 'home', active } = Astro.props;

// Single source of truth for the nav, used by both the home and sub headers.
// RSS is not here — it lives in the footer with the social links.
const links: Array<{ href: string; label: string; key: NavKey }> = [
	{ href: '/', label: 'Home', key: 'home' },
	{ href: '/tags/', label: 'Topics', key: 'topics' },
	{ href: '/projects', label: 'Projects', key: 'projects' },
	{ href: '/speaking', label: 'Speaking', key: 'speaking' },
	{ href: '/about', label: 'About', key: 'about' },
];
---

{
	variant === 'home' ? (
		<header class="home">
			<Avatar size={52} />
			<div class="intro">
				<h1 class="name">{SITE_TITLE}</h1>
				<p class="tagline">
					I build products to get trusted information to people in harm's
					way.{'\u00A0'}
					<a href="/about" class="tagline-more" aria-label="More about Cory">
						→
					</a>
				</p>
			</div>
		</header>
	) : (
		<header class="sub">
			<a href="/" class="avatar-link" aria-label="Home"><Avatar size={36} /></a>
			<a href="/" class="name-link">{SITE_TITLE}</a>
			<nav class="nav compact">
				{links.map((link) => (
					<a href={link.href} class:list={[active === link.key && 'active']}>
						{link.label}
					</a>
				))}
			</nav>
		</header>
	)
}

{
	variant === 'home' && (
		<nav class="nav full">
			{links.map((link) => (
				<a href={link.href} class:list={[active === link.key && 'active']}>
					{link.label}
				</a>
			))}
		</nav>
	)
}

<style>
	.avatar-link {
		display: inline-flex;
		flex-shrink: 0;
	}

	.home {
		display: flex;
		align-items: center;
		gap: 18px;
	}
	.intro {
		display: flex;
		flex-direction: column;
		gap: 3px;
		min-width: 0;
	}
	.name {
		margin: 0;
		font-size: 24px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
	}
	.tagline {
		font-size: 14.5px;
		line-height: 1.45;
		color: var(--muted);
		margin: 0;
	}
	/* Quiet trailing link into the About page. The visible label is just the
	   arrow, so it carries an aria-label; it's preceded by a non-breaking space
	   so it can never wrap onto a line by itself. */
	.tagline-more {
		color: var(--pine-2);
		font-weight: 500;
		/* Pad the arrow out to a 24x24 tap target (WCAG 2.2) and pull the same
		   amount back in margin, so the layout doesn't shift. */
		padding: 6px 7px;
		margin: -6px -7px;
	}
	.tagline-more:hover {
		color: var(--pine-hover);
	}
	.sub {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.name-link {
		font-size: 16px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.nav {
		display: flex;
		font-size: 14px;
		font-weight: 500;
		color: var(--muted);
	}
	.nav.full {
		gap: 24px;
		margin: 40px 0 60px;
	}
	.nav.compact {
		gap: 22px;
		margin-left: auto;
	}
	.nav a.active {
		color: var(--pine);
		border-bottom: 2px solid var(--pine);
		padding-bottom: 4px;
	}

	@media (max-width: 700px) {
		/* Five links won't fit a phone row at 14px — a small step down in size
		   and gap keeps them on one line at 375px wide, and they still wrap
		   cleanly on anything narrower. */
		.nav {
			font-size: 13px;
		}
		.nav.full {
			flex-wrap: wrap;
			gap: 14px 13px;
			margin: 28px 0 40px;
		}

		/* Sub-page header: let the compact nav wrap to its own line so no
		   items get clipped by the frame. */
		.sub {
			flex-wrap: wrap;
		}
		.nav.compact {
			margin-left: 0;
			margin-top: 6px;
			width: 100%;
			flex-wrap: wrap;
			gap: 14px 13px;
		}
	}
</style>
