---
import { SITE_TITLE } from '../consts';
import Avatar from './Avatar.astro';

interface Props {
	variant?: 'home' | 'sub';
	active?: 'home' | 'projects' | 'speaking' | 'about';
}
const { variant = 'home', active } = Astro.props;
---

{
	variant === 'home' ? (
		<header class="home">
			<Avatar size={52} />
			<div class="intro">
				<h1 class="name">{SITE_TITLE}</h1>
				<p class="tagline">
					I'm a product leader, entrepreneur and journalist.
				</p>
			</div>
		</header>
	) : (
		<header class="sub">
			<a href="/" class="avatar-link" aria-label="Home"><Avatar size={36} /></a>
			<a href="/" class="name-link">{SITE_TITLE}</a>
			<nav class="nav compact">
				<a href="/" class:list={[active === 'home' && 'active']}>Home</a>
				<a href="/projects" class:list={[active === 'projects' && 'active']}>Projects</a>
				<a href="/speaking" class:list={[active === 'speaking' && 'active']}>Speaking</a>
				<a href="/about" class:list={[active === 'about' && 'active']}>About</a>
				<a href="/rss.xml">RSS</a>
			</nav>
		</header>
	)
}

{
	variant === 'home' && (
		<nav class="nav full">
			<a href="/" class:list={[active === 'home' && 'active']}>Home</a>
			<a href="/projects" class:list={[active === 'projects' && 'active']}>Projects</a>
			<a href="/speaking" class:list={[active === 'speaking' && 'active']}>Speaking</a>
			<a href="/about" class:list={[active === 'about' && 'active']}>About</a>
			<a href="/rss.xml" class="push">RSS</a>
		</nav>
	)
}

<style>
	.avatar-link {
		display: inline-flex;
		flex-shrink: 0;
	}

	.home {
		display: flex;
		align-items: center;
		gap: 18px;
	}
	.intro {
		display: flex;
		flex-direction: column;
		gap: 3px;
		min-width: 0;
	}
	.name {
		margin: 0;
		font-size: 24px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
	}
	.tagline {
		font-size: 14.5px;
		line-height: 1.45;
		color: var(--muted);
		margin: 0;
	}
	.sub {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.name-link {
		font-size: 16px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.nav {
		display: flex;
		font-size: 14px;
		font-weight: 500;
		color: var(--muted);
	}
	.nav.full {
		gap: 24px;
		margin: 40px 0 60px;
	}
	.nav.compact {
		gap: 22px;
		margin-left: auto;
	}
	.nav .push {
		margin-left: auto;
	}
	.nav a.active {
		color: var(--pine);
		border-bottom: 2px solid var(--pine);
		padding-bottom: 4px;
	}

	@media (max-width: 700px) {
		.nav.full {
			flex-wrap: wrap;
			gap: 16px;
			margin: 28px 0 40px;
		}
		.nav .push {
			margin-left: 0;
		}

		/* Sub-page header: let the compact nav wrap to its own line so no
		   items get clipped by the frame. */
		.sub {
			flex-wrap: wrap;
		}
		.nav.compact {
			margin-left: 0;
			margin-top: 6px;
			width: 100%;
			flex-wrap: wrap;
			gap: 16px 18px;
		}
	}
</style>
