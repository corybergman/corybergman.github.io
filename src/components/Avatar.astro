---
import { Image } from 'astro:assets';
// Square crop of the same professional headshot the About page uses, so the
// face is consistent site-wide. The 404 page deliberately keeps the older
// candid shot (avatar.jpg) — that mismatch is the joke there.
import avatar from '../assets/avatar-headshot.jpg';

interface Props {
	size: number; // rendered diameter in px
}
const { size } = Astro.props;
---

<Image
	src={avatar}
	alt="Cory Bergman"
	width={size * 2}
	height={size * 2}
	class="avatar"
	style={`width:${size}px;height:${size}px`}
	loading="eager"
/>

<style>
	.avatar {
		border-radius: 50%;
		filter: var(--photo-filter);
		object-fit: cover;
		display: block;
		flex-shrink: 0;
	}
</style>
