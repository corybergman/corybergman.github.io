---
// Map masthead — abstract globe graticule (from design handoff, MASTHEAD.md).
// variant="tall"  → homepage (176px band)
// variant="short" → post / about / all subpages (92px band)
interface Props {
	variant?: 'tall' | 'short';
}
const { variant = 'short' } = Astro.props;
---

{variant === 'tall' ? (
	<div class="masthead masthead--tall" aria-hidden="true">
		<svg viewBox="0 0 920 176" preserveAspectRatio="xMidYMid slice">
			<g fill="none" stroke="#dfe3da" stroke-width="1">
				<path d="M-20 34 C 200 18, 720 18, 940 34" />
				<path d="M-20 70 C 200 52, 720 52, 940 70" />
				<path d="M-20 106 C 200 124, 720 124, 940 106" />
				<path d="M-20 142 C 200 162, 720 162, 940 142" />
				<path d="M60 -10 C 34 60, 34 120, 60 186" />
				<path d="M180 -10 C 162 60, 162 120, 180 186" />
				<path d="M300 -10 C 290 60, 290 120, 300 186" />
				<path d="M420 -10 C 416 60, 416 120, 420 186" />
				<path d="M540 -10 C 544 60, 544 120, 540 186" />
				<path d="M660 -10 C 670 60, 670 120, 660 186" />
				<path d="M780 -10 C 798 60, 798 120, 780 186" />
				<path d="M900 -10 C 926 60, 926 120, 900 186" />
			</g>
			<path d="M-20 88 C 200 74, 720 74, 940 88" fill="none" stroke="#c3cbbe" stroke-width="1.4" stroke-dasharray="6 5" />
			<g fill="none" stroke="#2f4438" stroke-width="1.3" opacity="0.55">
				<path d="M148 118 C 260 46, 380 44, 470 84" />
				<path d="M470 84 C 566 122, 660 118, 726 66" />
				<path d="M148 118 C 300 154, 560 152, 726 66" />
			</g>
			<g>
				<circle cx="148" cy="118" r="19" fill="#2f4438" opacity="0.07" />
				<circle cx="148" cy="118" r="11" fill="#2f4438" opacity="0.12" />
				<circle cx="148" cy="118" r="4.5" fill="#2f4438" />
				<circle cx="470" cy="84" r="26" fill="#2f4438" opacity="0.07" />
				<circle cx="470" cy="84" r="15" fill="#2f4438" opacity="0.13" />
				<circle cx="470" cy="84" r="5.5" fill="#2f4438" />
				<circle cx="726" cy="66" r="16" fill="#2f4438" opacity="0.08" />
				<circle cx="726" cy="66" r="4" fill="#2f4438" />
				<circle cx="252" cy="46" r="3" fill="#87a383" />
				<circle cx="612" cy="132" r="3" fill="#87a383" />
				<circle cx="852" cy="104" r="3" fill="#87a383" />
				<circle cx="352" cy="146" r="2.5" fill="#a9b6a5" />
				<circle cx="560" cy="30" r="2.5" fill="#a9b6a5" />
			</g>
			<g fill="#8e9a8a" font-family="'IBM Plex Mono', monospace" font-size="9">
				<text x="168" y="122">47.6°N</text>
				<text x="490" y="88">SEA</text>
				<text x="744" y="70">122.3°W</text>
			</g>
		</svg>
	</div>
) : (
	<div class="masthead masthead--short" aria-hidden="true">
		<svg viewBox="0 0 920 92" preserveAspectRatio="xMidYMid slice">
			<g fill="none" stroke="#dfe3da" stroke-width="1">
				<path d="M-20 20 C 200 8, 720 8, 940 20" />
				<path d="M-20 72 C 200 84, 720 84, 940 72" />
				<path d="M80 -10 C 62 30, 62 62, 80 102" />
				<path d="M230 -10 C 220 30, 220 62, 230 102" />
				<path d="M380 -10 C 376 30, 376 62, 380 102" />
				<path d="M540 -10 C 544 30, 544 62, 540 102" />
				<path d="M700 -10 C 710 30, 710 62, 700 102" />
				<path d="M860 -10 C 878 30, 878 62, 860 102" />
			</g>
			<path d="M-20 46 C 200 36, 720 36, 940 46" fill="none" stroke="#c3cbbe" stroke-width="1.3" stroke-dasharray="6 5" />
			<g fill="none" stroke="#2f4438" stroke-width="1.2" opacity="0.5">
				<path d="M188 66 C 300 26, 400 26, 468 48" />
				<path d="M468 48 C 560 74, 660 68, 722 36" />
			</g>
			<g>
				<circle cx="188" cy="66" r="12" fill="#2f4438" opacity="0.08" />
				<circle cx="188" cy="66" r="3.6" fill="#2f4438" />
				<circle cx="468" cy="48" r="17" fill="#2f4438" opacity="0.08" />
				<circle cx="468" cy="48" r="10" fill="#2f4438" opacity="0.13" />
				<circle cx="468" cy="48" r="4.6" fill="#2f4438" />
				<circle cx="722" cy="36" r="11" fill="#2f4438" opacity="0.08" />
				<circle cx="722" cy="36" r="3.4" fill="#2f4438" />
				<circle cx="304" cy="28" r="2.5" fill="#87a383" />
				<circle cx="606" cy="70" r="2.5" fill="#87a383" />
				<circle cx="846" cy="58" r="2.5" fill="#a9b6a5" />
			</g>
			<g fill="#8e9a8a" font-family="'IBM Plex Mono', monospace" font-size="8.5">
				<text x="204" y="70">47.6°N</text>
				<text x="484" y="52">SEA</text>
				<text x="738" y="40">122.3°W</text>
			</g>
		</svg>
	</div>
)}

<style>
	.masthead {
		position: relative;
		background: #f7f8f5;
		overflow: hidden;
	}
	.masthead--tall {
		height: 176px;
	}
	.masthead--short {
		height: 92px;
	}
	.masthead svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	@media (max-width: 700px) {
		.masthead--tall {
			height: 132px;
		}
		.masthead--short {
			height: 76px;
		}
	}
</style>
