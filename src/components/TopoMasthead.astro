---
// Photo masthead (900×200). variant="tall" → homepage (masthead1),
// variant="short" → all other pages (masthead2).
import { Image } from 'astro:assets';
import mastheadHome from '../assets/masthead1.png';
import mastheadSub from '../assets/masthead2.png';

interface Props {
	variant?: 'tall' | 'short';
}
const { variant = 'short' } = Astro.props;
const src = variant === 'tall' ? mastheadHome : mastheadSub;
---

<div class="masthead" aria-hidden="true">
	<Image
		src={src}
		alt=""
		widths={[440, 700, 900]}
		sizes="(max-width: 700px) 100vw, 832px"
		class="masthead-img"
	/>
</div>

<style>
	.masthead {
		background: var(--page);
		padding: 30px var(--frame-pad) 20px;
	}
	.masthead-img {
		display: block;
		width: 100%;
		max-width: 900px;
		height: auto;
		margin: 0 auto;
		border-radius: 8px;
	}
	@media (max-width: 700px) {
		.masthead {
			padding: 18px var(--frame-pad);
		}
	}
</style>
