---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, postUrl } from '../consts';
import portrait from '../assets/corybe_2026.jpg';
import faceCrop from '../assets/headshot-2026.jpg';
import { engagements } from '../lib/speaking';

// Home page (redesigned 2026-09 from the Claude Design handoff in
// ~/Documents/design_handoff_corybe_home/): a showcase up top — positioning,
// then upcoming speaking events — with a condensed blog roll underneath. The
// roll shows the newest RECENT_COUNT posts only; the archive lives on /writing/.
// "Where I focus" was dropped 2026-10-08 (Cory's call).
const RECENT_COUNT = 5;

// Phones get the About page's square face crop instead of the head-and-shoulders
// portrait: at thumbnail size the wider shot leaves the face too small.
const desktopPortrait = await getImage({ src: portrait, widths: [295, 590] });
const phonePortrait = await getImage({
	src: faceCrop,
	widths: [112, 224, 336],
	format: 'webp',
});
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, RECENT_COUNT);

---

<BaseLayout
	title="Cory Bergman — Trusted information for people in harm's way"
	description={SITE_DESCRIPTION}
	variant="home"
	active="home"
>
	<section class="hero">
		<div class="hero-text">
			<h1>Trusted information for people in harm's way.</h1>
			<p class="lede">
				I combine technology and journalism to build mission-critical products
				in global security and disaster response.
			</p>
			<p class="affiliation">
				Co-founder and chief product officer at <a href="https://www.factal.com"
					>Factal</a
				>.
			</p>
			<div class="hero-links">
				<a href="/about" class="link">More about me →</a>
			</div>
		</div>
		<!-- Desktop: the head-and-shoulders portrait in a 250×225 box. Phones
		     (≤700px): the square face crop, via the <source> below. -->
		<picture class="portrait-frame">
			<source
				media="(max-width: 700px)"
				srcset={phonePortrait.srcSet.attribute}
				sizes="112px"
				type="image/webp"
			/>
			<img
				src={desktopPortrait.src}
				srcset={desktopPortrait.srcSet.attribute}
				sizes="295px"
				width={desktopPortrait.attributes.width}
				height={desktopPortrait.attributes.height}
				alt="Cory Bergman"
				class="portrait"
				loading="eager"
				decoding="async"
			/>
		</picture>
	</section>

	<section class="speaking">
		<p class="eyebrow tight">Upcoming speaking events</p>
		<p class="speaking-head">
			I speak about practical AI for global security and risk teams.
		</p>
		<ul class="events">
			{
				engagements.map((e) => (
					<li class="event">
						{e.url ? (
							<a href={e.url} class="event-title">
								{e.event}
							</a>
						) : (
							<span class="event-title">{e.event}</span>
						)}
						{(e.venue || e.date) && (
							<span class="event-meta">
								{[e.venue, e.date].filter(Boolean).join(' · ')}
							</span>
						)}
					</li>
				))
			}
		</ul>
		<div class="speaking-links">
			<a href="/speaking" class="link">Learn more about speaking →</a>
		</div>
	</section>

	<section class="writing">
		<div class="writing-head">
			<h2 class="eyebrow">Recent writing</h2>
		</div>
		{
			posts.map((post) => (
				<article class="post">
					<p class="post-date">
						<FormattedDate date={post.data.pubDate} />
					</p>
					<div>
						<h3 class="post-title">
							<a href={postUrl(post)}>{post.data.title}</a>
						</h3>
						<p class="post-excerpt">{post.data.description}</p>
					</div>
				</article>
			))
		}
		<div class="archive-link">
			<a href="/writing/" class="link">Browse the full archive, back to 2011 →</a>
		</div>
	</section>
</BaseLayout>

<style>
	/* Shared bits ---------------------------------------------------------- */
	.eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 11.5px;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--section-label);
	}
	.eyebrow.tight {
		margin: 0 0 18px;
	}
	.link {
		font-size: 15px;
		color: var(--pine);
	}
	.link.small {
		font-size: 14px;
	}
	.link:hover {
		color: var(--pine-hover);
	}

	/* Hero ------------------------------------------------------------------ */
	.hero {
		padding: 35px 0 35px;
		display: flex;
		flex-wrap: wrap;
		gap: 52px;
		align-items: start;
	}
	.hero-text {
		flex: 1 1 320px;
		min-width: 0;
	}
	.hero h1 {
		margin: 0;
		font-size: clamp(30px, 3.9vw, 44px);
		font-weight: 600;
		line-height: 1.18;
		letter-spacing: -0.02em;
		color: var(--ink);
		text-wrap: pretty;
	}
	.lede {
		margin: 18px 0 0;
		max-width: var(--content-max);
		font-size: 17px;
		line-height: 1.6;
		color: var(--excerpt);
		text-wrap: pretty;
	}
	.affiliation {
		margin: 12px 0 0;
		max-width: var(--content-max);
		font-size: 15.5px;
		line-height: 1.6;
		color: var(--muted);
	}
	.affiliation a {
		color: var(--pine);
	}
	.affiliation a:hover {
		color: var(--pine-hover);
	}
	.hero-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 20px;
	}
	/* min-width: 0 matters: without it a replaced element's automatic minimum
	   size clamps to max-width and the photo wraps onto its own row. */
	/* The <picture> wrapper is layout-transparent so the img stays the flex
	   (and, on phones, grid) item. */
	.portrait-frame {
		display: contents;
	}
	/* <source> never renders, but if anything gives it a box it becomes an
	   empty flex item and adds a second 52px gap. */
	.portrait-frame source {
		display: none;
	}
	.portrait {
		flex: 0 1 250px;
		min-width: 0;
		width: 100%;
		max-width: 295px;
		height: 225px;
		object-fit: cover;
		object-position: 50% 8%;
		border-radius: 12px;
		filter: var(--photo-filter);
		display: block;
	}

	/* Speaking card --------------------------------------------------------- */
	.speaking {
		border: 1px solid var(--rule);
		border-radius: 6px;
		background: var(--card-bg);
		padding: 36px;
	}
	.speaking-head {
		margin: 0;
		font-size: clamp(19px, 2vw, 23px);
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.015em;
		color: var(--ink);
		text-wrap: pretty;
	}
	/* Events: title (linked when there's a URL) over a mono venue · date line.
	   Descriptions stay on /speaking. */
	.events {
		list-style: none;
		margin: 22px 0 0;
		padding: 0;
		border-top: 1px solid var(--rule);
	}
	.event {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 16px 0;
		border-bottom: 1px solid var(--rule);
	}
	.event-title {
		font-size: 17px;
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.01em;
		color: var(--ink);
		text-wrap: pretty;
	}
	a.event-title:hover {
		color: var(--pine);
	}
	.event-meta {
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--faint);
	}
	.speaking-links {
		margin-top: 20px;
	}

	/* Writing --------------------------------------------------------------- */
	.writing {
		padding: 56px 0 0;
	}
	.writing-head {
		border-bottom: 1px solid var(--rule);
		padding-bottom: 14px;
	}
	.post {
		display: grid;
		grid-template-columns: 110px minmax(0, 1fr);
		gap: 28px;
		padding: 28px 0;
		border-bottom: 1px solid var(--rule);
	}
	.post-date {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12.5px;
		line-height: 1.9;
		color: var(--faint);
	}
	.post-title {
		margin: 0 0 8px;
		font-size: 21px;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: var(--ink);
		text-wrap: pretty;
	}
	.post-title a:hover {
		color: var(--pine);
	}
	.post-excerpt {
		margin: 0;
		max-width: 70ch;
		font-size: 15.5px;
		line-height: 1.65;
		color: var(--excerpt);
		text-wrap: pretty;
	}
	.archive-link {
		padding-top: 26px;
	}

	@media (max-width: 700px) {
		/* Phones: instead of wrapping onto its own row at full size, the portrait
		   shrinks and sits beside the H1. display: contents lets the h1 and the
		   copy below it join the hero grid directly. */
		.hero {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			column-gap: 18px;
			row-gap: 0;
		}
		.hero-text {
			display: contents;
		}
		.hero h1 {
			grid-column: 1;
			grid-row: 1;
			align-self: center;
		}
		.lede,
		.affiliation,
		.hero-links {
			grid-column: 1 / -1;
		}
		.portrait {
			grid-column: 2;
			grid-row: 1;
			width: 112px;
			height: 112px;
			object-position: 50% 50%;
			border-radius: 10px;
		}
		.speaking {
			padding: 26px 22px;
		}
		.post {
			grid-template-columns: 1fr;
			gap: 6px;
		}
	}
</style>
