---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, postUrl } from '../consts';
import portrait from '../assets/corybe_2026.jpg';

// Home page (redesigned 2026-09 from the Claude Design handoff in
// ~/Documents/design_handoff_corybe_home/): a showcase up top — positioning,
// focus areas, speaking — with a condensed blog roll underneath. The roll shows
// the newest RECENT_COUNT posts only; the archive lives on /tags/.
const RECENT_COUNT = 5;
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, RECENT_COUNT);

const focus = [
	{
		text: 'Products and companies that help people act on trusted information in critical situations.',
		label: 'More in projects →',
		href: '/projects',
	},
	{
		text: "Journalistic methods for finding what's true when speed matters and mistakes have consequences.",
		label: 'More about journalism →',
		href: '/tags/journalism/',
	},
	{
		text: 'Practical applications, emerging risks and the human judgment needed to use AI well.',
		label: 'More about AI →',
		href: '/tags/ai/',
	},
];
---

<BaseLayout
	title="Cory Bergman — AI, Global Security & Journalism"
	description={SITE_DESCRIPTION}
	variant="home"
	active="home"
>
	<section class="hero">
		<div class="hero-text">
			<h1>Trusted information for people in harm's way.</h1>
			<p class="lede">
				I combine technology and journalism to build mission-critical products
				in global security and disaster response.
			</p>
			<p class="affiliation">
				Co-founder and chief product officer at <a href="https://www.factal.com"
					>Factal</a
				>.
			</p>
			<div class="hero-links">
				<a href="/about" class="link">More about me →</a>
			</div>
		</div>
		<!-- The portrait is a three-quarter shot; the fixed 225px box with a
		     high object-position crops it to head and shoulders (no hands). -->
		<Image
			src={portrait}
			alt="Cory Bergman"
			widths={[295, 590]}
			sizes="295px"
			class="portrait"
			loading="eager"
		/>
	</section>

	<section class="focus">
		<p class="eyebrow">Where I focus</p>
		<div class="focus-grid">
			{
				focus.map((f) => (
					<div class="focus-col">
						<p>{f.text}</p>
						<a href={f.href} class="link small">
							{f.label}
						</a>
					</div>
				))
			}
		</div>
	</section>

	<section class="speaking">
		<div>
			<p class="eyebrow tight">Speaking</p>
			<p class="speaking-head">
				I speak about practical AI for global security and risk teams.
			</p>
			<p class="speaking-body">
				Drawing on my work as a journalist and product builder, I bring
				real-life examples and practical approaches to keynotes, panels and
				training workshops.
			</p>
			<div class="speaking-links">
				<a href="/speaking" class="link">Learn about upcoming speaking events →</a>
			</div>
		</div>
	</section>

	<section class="writing">
		<div class="writing-head">
			<h2 class="eyebrow">Writing</h2>
		</div>
		{
			posts.map((post) => (
				<article class="post">
					<p class="post-date">
						<FormattedDate date={post.data.pubDate} />
					</p>
					<div>
						<h3 class="post-title">
							<a href={postUrl(post)}>{post.data.title}</a>
						</h3>
						<p class="post-excerpt">{post.data.description}</p>
					</div>
				</article>
			))
		}
		<div class="archive-link">
			<a href="/tags/" class="link">Browse the full archive, back to 2011 →</a>
		</div>
	</section>
</BaseLayout>

<style>
	/* Shared bits ---------------------------------------------------------- */
	.eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 11.5px;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--section-label);
	}
	.eyebrow.tight {
		margin: 0 0 18px;
	}
	.link {
		font-size: 15px;
		color: var(--pine);
	}
	.link.small {
		font-size: 14px;
	}
	.link:hover {
		color: var(--pine-hover);
	}

	/* Hero ------------------------------------------------------------------ */
	.hero {
		padding: 35px 0 35px;
		display: flex;
		flex-wrap: wrap;
		gap: 52px;
		align-items: start;
	}
	.hero-text {
		flex: 1 1 320px;
		min-width: 0;
	}
	.hero h1 {
		margin: 0;
		font-size: clamp(30px, 3.9vw, 44px);
		font-weight: 600;
		line-height: 1.18;
		letter-spacing: -0.02em;
		color: var(--ink);
		text-wrap: pretty;
	}
	.lede {
		margin: 18px 0 0;
		max-width: var(--content-max);
		font-size: 17px;
		line-height: 1.6;
		color: var(--excerpt);
		text-wrap: pretty;
	}
	.affiliation {
		margin: 12px 0 0;
		max-width: var(--content-max);
		font-size: 15.5px;
		line-height: 1.6;
		color: var(--muted);
	}
	.affiliation a {
		color: var(--pine);
	}
	.affiliation a:hover {
		color: var(--pine-hover);
	}
	.hero-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 20px;
	}
	/* min-width: 0 matters: without it a replaced element's automatic minimum
	   size clamps to max-width and the photo wraps onto its own row. */
	.portrait {
		flex: 0 1 250px;
		min-width: 0;
		width: 100%;
		max-width: 295px;
		height: 225px;
		object-fit: cover;
		object-position: 50% 8%;
		border-radius: 12px;
		filter: var(--photo-filter);
		display: block;
	}

	/* Where I focus --------------------------------------------------------- */
	.focus {
		border-top: 1px solid var(--rule);
		padding: 40px 0 56px;
	}
	.focus .eyebrow {
		margin-bottom: 24px;
	}
	.focus-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 40px;
	}
	.focus-col {
		display: flex;
		flex-direction: column;
		gap: 10px;
		align-items: start;
	}
	.focus-col p {
		margin: 0;
		font-size: 16px;
		line-height: 1.55;
		color: var(--ink);
		text-wrap: pretty;
	}
	/* Bottom-align the links across columns of unequal text length. */
	.focus-col .link {
		margin-top: auto;
		padding-top: 4px;
	}

	/* Speaking card --------------------------------------------------------- */
	.speaking {
		border: 1px solid var(--rule);
		border-radius: 6px;
		background: var(--card-bg);
		padding: 36px;
	}
	.speaking-head {
		margin: 0;
		font-size: clamp(19px, 2vw, 23px);
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.015em;
		color: var(--ink);
		text-wrap: pretty;
	}
	.speaking-body {
		margin: 14px 0 0;
		max-width: 75ch;
		font-size: 15.5px;
		line-height: 1.6;
		color: var(--excerpt);
		text-wrap: pretty;
	}
	.speaking-links {
		margin-top: 20px;
	}

	/* Writing --------------------------------------------------------------- */
	.writing {
		padding: 56px 0 0;
	}
	.writing-head {
		border-bottom: 1px solid var(--rule);
		padding-bottom: 14px;
	}
	.post {
		display: grid;
		grid-template-columns: 110px minmax(0, 1fr);
		gap: 28px;
		padding: 28px 0;
		border-bottom: 1px solid var(--rule);
	}
	.post-date {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12.5px;
		line-height: 1.9;
		color: var(--faint);
	}
	.post-title {
		margin: 0 0 8px;
		font-size: 21px;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: var(--ink);
		text-wrap: pretty;
	}
	.post-title a:hover {
		color: var(--pine);
	}
	.post-excerpt {
		margin: 0;
		max-width: 70ch;
		font-size: 15.5px;
		line-height: 1.65;
		color: var(--excerpt);
		text-wrap: pretty;
	}
	.archive-link {
		padding-top: 26px;
	}

	@media (max-width: 700px) {
		.post {
			grid-template-columns: 1fr;
			gap: 6px;
		}
	}
</style>
