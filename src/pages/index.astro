---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from '../components/PostListItem.astro';
import { SITE_DESCRIPTION, postUrl } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Posts migrated from the old Tumblr blog carry a `tumblrId`. They sort to the
// bottom of the feed; mark where they begin so we can draw a quiet divider
// between recent writing and the archive. Data-driven, so it stays correct as
// new posts are published (no hardcoded date).
const archiveStart = posts.findIndex((post) => post.data.tumblrId);

// Feed excerpt = the opening of the post's own text (not the frontmatter
// description). Strip light Markdown and collapse whitespace; the CSS then
// clamps it to two lines with an ellipsis.
function excerptFrom(body: string) {
	return body
		.replace(/^#{1,6}\s+/gm, '') // heading markers
		.replace(/^>\s?/gm, '') // blockquote markers
		.replace(/[*_`]/g, '') // emphasis / code ticks
		.replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1') // links/images -> text
		.replace(/<[^>]+>/g, ' ') // strip raw HTML tags (keep their text)
		.replace(/\s+/g, ' ')
		.trim()
		.slice(0, 400);
}
---

<BaseLayout
	title="Cory Bergman — AI, Global Security & Journalism"
	description={SITE_DESCRIPTION}
	variant="home"
	active="home"
>
	<section class="feed">
		{
			posts.map((post, i) => (
				<Fragment>
					{i === archiveStart && archiveStart > 0 && (
						<div class="feed-divider">
							<span>Earlier writing · 2011–2024</span>
						</div>
					)}
					<PostListItem
						href={postUrl(post)}
						title={post.data.title}
						excerpt={excerptFrom(post.body ?? '')}
						pubDate={post.data.pubDate}
					/>
				</Fragment>
			))
		}
	</section>
</BaseLayout>

<style>
	/* Quiet boundary between recent posts and the migrated Tumblr archive:
	   a hairline with a small mono label centered on it, echoing the
	   coordinate/trail feel of the masthead. */
	.feed-divider {
		display: flex;
		align-items: center;
		gap: 18px;
		margin: 14px 0 50px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--faint);
	}
	.feed-divider::before,
	.feed-divider::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--rule);
	}
	.feed-divider span {
		flex: none;
	}
</style>
