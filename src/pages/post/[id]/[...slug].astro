---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { postUrl } from '../../../consts';

// Migrated Tumblr posts are served at their original `/post/<tumblrId>/<slug>/`
// URL so search-indexed links keep resolving. Native posts use `/blog/`.
export async function getStaticPaths() {
	const all = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return all
		.filter((post) => post.data.tumblrId)
		.map((post) => {
			const i = all.indexOf(post);
			const older = all[i + 1];
			return {
				params: { id: post.data.tumblrId, slug: post.id },
				props: {
					post,
					prevPost: older
						? { href: postUrl(older), title: older.data.title }
						: null,
				},
			};
		});
}
type Props = {
	post: CollectionEntry<'blog'>;
	prevPost: { href: string; title: string } | null;
};

const { post, prevPost } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} prevPost={prevPost}>
	<Content />
</BlogPost>
