// ─────────────────────────────────────────────────────────────────────────────
---

<BaseLayout
	title="Projects — Companies Founded by Cory Bergman"
	description="The companies Cory Bergman founded — Factal, Breaking News, My Ballard, Lost Remote — plus an index of his writing and the press coverage about him over the years."
	variant="sub"
	active="projects"
>
	<div class="page">
		<h1>Projects</h1>
		<p class="intro">
			Companies I've co-founded, products I've made and things I've published.
		</p>

		<h2 class="section">Companies</h2>
		<ul class="entries entries--companies">
			{
				companies.map((item) => (
					<li class="entry entry--logo">
						<div class="entry-head">
							{item.logo && (
								<a
									href={companyUrl(item)}
									class="entry-logo-link"
									aria-label={item.title}
									tabindex="-1"
								>
									<Image
										src={item.logo}
										alt={`${item.title} logo`}
										class="entry-logo"
									/>
								</a>
							)}
							<div class="entry-heading">
								<a href={companyUrl(item)} class="entry-title">
									{item.title}
								</a>
								{item.date && <span class="entry-meta">{item.date}</span>}
							</div>
						</div>
						{item.description && (
							<p class="entry-excerpt">{companyPlainText(item)}</p>
						)}
						<a href={companyUrl(item)} class="entry-more">
							Read more →
						</a>
					</li>
				))
			}
		</ul>

		<h2 class="section">Writing</h2>
		{
			writing.length > 0 ? (
				<ul class="entries">
					{writing.map((item) => (
						<li class="entry">
							{item.url ? (
								<a href={item.url} class="entry-title">
									{item.title}
								</a>
							) : (
								<span class="entry-title">{item.title}</span>
							)}
							{(item.source || item.date) && (
								<span class="entry-meta">
									{[item.source, item.date].filter(Boolean).join(' · ')}
								</span>
							)}
							{item.description && (
								<div class="entry-desc" set:html={item.description} />
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="soon">Coming soon.</p>
			)
		}

		<h2 class="section">Press</h2>
		{
			press.length > 0 ? (
				<ul class="entries">
					{press.map((item) => (
						<li class="entry">
							<a href={item.url} class="entry-title">
								{item.title}
							</a>
							{(item.source || item.date) && (
								<span class="entry-meta">
									{[item.source, item.date].filter(Boolean).join(' · ')}
								</span>
							)}
							{item.description && (
								<p class="entry-desc" set:html={item.description} />
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="soon">Coming soon.</p>
			)
		}
	</div>
</BaseLayout>

<style>
	.page {
		max-width: var(--content-max);
		margin: 50px auto 0;
	}
	.page h1 {
		font-size: 34px;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 12px;
	}
	.intro {
		font-size: 16.5px;
		line-height: 1.7;
		color: var(--muted);
		margin: 0;
	}
	.section {
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--section-label);
		margin: 48px 0 20px;
	}
	.entries {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	/* Company cards now carry a teaser, so they need more air between them
	   than the single-line Writing and Press rows. */
	.entries--companies {
		gap: 34px;
	}
	.entry-head {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.entry-logo-link {
		flex: none;
		display: inline-flex;
		border-radius: 9px;
		transition: opacity 0.15s ease;
	}
	.entry-logo-link:hover {
		opacity: 0.82;
	}
	.entry-logo {
		flex: none;
		display: block;
		width: 44px;
		height: 44px;
		border-radius: 9px;
		object-fit: cover;
		border: 1px solid var(--hairline);
	}
	.entry-heading {
		min-width: 0;
	}
	.entry--logo .entry-desc {
		margin-top: 12px;
	}
	/* Company teaser: first couple of lines, then truncate — same treatment as
	   the post excerpts on the home feed, two lines instead of three. */
	.entry-excerpt {
		font-size: 15.5px;
		line-height: 1.65;
		color: var(--excerpt);
		margin: 12px 0 0;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
	}
	.entry-more {
		display: inline-block;
		font-size: 13.5px;
		font-weight: 500;
		color: var(--pine-2);
		margin-top: 8px;
	}
	.entry-more:hover {
		color: var(--pine-hover);
	}
	.entry-title {
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
		line-height: 1.35;
	}
	.entry-title:hover {
		color: var(--pine-hover);
	}
	.entry-meta {
		display: block;
		font-size: 13px;
		color: var(--faint);
		margin-top: 3px;
	}
	.entry-desc {
		font-size: 15.5px;
		line-height: 1.6;
		color: var(--excerpt);
		margin: 6px 0 0;
	}
	.entry-desc :global(a) {
		color: var(--pine);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.entry-desc :global(ul) {
		margin: 8px 0 0;
		padding-left: 20px;
	}
	.entry-desc :global(li) {
		margin: 4px 0;
	}
	.soon {
		font-size: 15.5px;
		color: var(--faint);
		margin: 0;
	}
</style>
