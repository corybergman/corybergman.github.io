---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { companies, companyUrl, companyPlainText } from '../lib/companies';

// ── Fill these in ────────────────────────────────────────────────────────────
// Each entry: { title, url, source, date, description, logo }
//   title       – the headline (becomes the link text)
//   url         – link to the piece
//   source      – publication / outlet (optional)
//   date        – year or date string (optional)
//   description – one short line (optional)
//   logo        – imported image shown as a badge (optional)
//
// Companies live in src/lib/companies.ts, because each one also has its own
// page at /projects/<slug>/. This index shows only logo, name and date; the
// descriptions are on those pages.
// "writing" = pieces Cory wrote. "press" = coverage about Cory.
type Entry = {
	title: string;
	url?: string;
	source?: string;
	date?: string;
	description?: string;
	logo?: ImageMetadata;
};

const writing: Entry[] = [
	{
		title: 'Factal blog',
		url: 'https://blog.factal.com',
		date: '2018–present',
		description: `I don't write as many of these posts anymore, but here are a few of my highlights:
<ul>
<li><a href="https://blog.factal.com/2024/09/the-rising-cost-of-misinformation-and-noise-in-risk-intelligence/">The rising cost of misinformation and noise in risk intelligence</a> (2024)</li>
<li><a href="https://blog.factal.com/2023/05/pentagon-non-explosion-is-an-unsettling-preview-of-ais-ability-to-disrupt-reality/">An unsettling preview of AI's ability to disrupt reality</a> (2023)</li>
<li><a href="https://blog.factal.com/2022/01/what-security-intelligence-teams-can-learn-from-emergency-doctors-to-accelerate-information-triage/">What security teams can learn about triage from emergency doctors</a> (2022)</li>
<li><a href="https://blog.factal.com/2019/02/how-information-vacuums-breed-misinformation/">How information vacuums breed misinformation</a> (2019)</li>
</ul>`,
	},
	{
		title: 'LinkedIn articles',
		date: '2015–present',
		description: `Occasional longer pieces published straight to LinkedIn:
<ul>
<li><a href="https://www.linkedin.com/pulse/ai-catching-up-security-intelligence-analysts-heres-what-cory-bergman-sbemc/">AI is catching up to security intel analysts, but here's what it still can't do</a> (2026)</li>
<li><a href="https://www.linkedin.com/pulse/every-day-soon-become-april-fools-cory-bergman-qo4sc/">Every day will soon become April Fool's Day</a> (2024)</li>
<li><a href="https://www.linkedin.com/pulse/push-notification-paradox-when-people-actually-want-more-cory-bergman/">The push notification paradox: When people actually want more alerts</a> (2015)</li>
</ul>`,
	},
	{
		title: 'Medium (Breaking News)',
		url: 'https://medium.com/@breakingnews',
		date: '2015–2016',
		description: `The last few years' worth of Breaking News' announcements.`,
	},
	{
		title: 'Tumblr (Breaking News)',
		url: 'https://www.tumblr.com/breakingblog',
		date: '2010–2015',
		description: `I wrote a LOT about Breaking News' new features and innovations.`,
	},
	{
		title: 'My Ballard',
		url: 'https://www.myballard.com',
		date: '2007–2020',
		description: `My wife and I blogged about a Seattle neighborhood while we juggled two kids and our real jobs. Here are a couple of my <a href="https://www.myballard.com/2017/12/11/our-most-memorable-stories-on-my-ballards-10th-anniversary/">favorite stories</a>:
<ul>
<li><a href="https://www.myballard.com/2008/01/13/the-poster-lady-of-ballard-growth/">New building swallowing woman's home</a> (saga inspired Disney movie "Up")</li>
<li><a href="https://phinneywood.com/2009/10/2-alarm-fire-burning-on-85th/">3-alarm arson fire destroys Greenwood businesses</a> (won a national SPJ award)</li>
</ul>`,
	},
];

