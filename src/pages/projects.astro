---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import factalLogo from '../assets/factal.png';
import breakingNewsLogo from '../assets/breaking-news.png';
import myBallardLogo from '../assets/my-ballard.png';
import lostRemoteLogo from '../assets/lost-remote.png';

// ── Fill these in ────────────────────────────────────────────────────────────
// Each entry: { title, url, source, date, description, logo }
//   title       – the headline (becomes the link text)
//   url         – link to the piece
//   source      – publication / outlet (optional)
//   date        – year or date string (optional)
//   description – one short line (optional)
//   logo        – imported image shown as a badge (optional; Companies use it)
//
// "companies" = ventures Cory founded or helped build.
// "writing" = pieces Cory wrote. "press" = coverage about Cory.
const companies: Array<{
	title: string;
	url?: string;
	source?: string;
	date?: string;
	description?: string;
	logo?: ImageMetadata;
}> = [
	{
		title: 'Factal',
		url: 'https://www.factal.com',
		date: '2018–present',
		logo: factalLogo,
		description: `Factal is a verified risk intelligence platform for global security, risk and supply chain teams. It sprang from the ashes of Breaking News, pairing AI with experienced journalists to empower global organizations to protect their people and operations at scale. Co-founded by Ben Tesch, Charlie Tillinghast and me, Factal brought back several Breaking News team members, got funded and <a href="https://blog.factal.com/2018/08/introducing-factal-from-the-founders-of-breaking-news/">launched</a> in October 2018. It grew quickly as global volatility and AI-generated content made it harder for companies to navigate critical events in real time. Today its members include many of the largest companies in the world, and I'm particularly proud that we provide Factal free to more than 300 humanitarian and disaster relief organizations.`,
	},
	{
		title: 'Breaking News (NBC News)',
		date: '2010–2016',
		logo: breakingNewsLogo,
		description: `Breaking News began as an experiment inside MSNBC Interactive, the joint venture of Microsoft and NBC. Co-founded by Ben Tesch, Tom Brew and me, we began with the Twitter account @breakingnews, which <a href="https://www.theguardian.com/technology/2009/dec/01/twitter-bno-msnbc">MSNBC took over</a> in an agreement with its creator, Michael van Poppel. We then added the domain, BreakingNews.com, and launched a mobile app. The idea was simple: provide the fastest, accurate breaking news available, linking the best original sources – even if they were NBC's competitors. In 2012, NBC took over full control of MSNBC Interactive, and the network embraced the experiment. Over the next few years, we launched a series of groundbreaking mobile features including <a href="https://www.tumblr.com/breakingblog/88568000254/introducing-proximity-alerts-and-much-more-in-the?source=share">proximity alerts</a>, <a href="https://www.tumblr.com/breakingblog/74299826263/news-organizations-everywhere-are-going-bieber?source=share">muting</a> and <a href="https://medium.com/@breakingnews/reinventing-news-tips-as-social-media-signals-1b343f1160b9">nearby tips</a> (which won a <a href="https://awards.journalists.org/entries/nearby-tipping/">national journalism award</a> and helped us break some of the world's largest stories). The app exploded in popularity, outpacing NBC News' own mobile active user growth, but revenue remained a challenge. When the new NBC News president decided to focus on video, Breaking News got the boot. We <a href="https://medium.com/@breakingnews/breaking-news-is-shutting-down-49104e9df789">published our last update</a> on Dec. 31, 2016.`,
	},
	{
		title: 'My Ballard',
		url: 'https://www.myballard.com',
		date: '2007–present',
		logo: myBallardLogo,
		description: `I co-founded My Ballard with my wife Kate when we moved to the Seattle neighborhood of Ballard. It began as a part-time blog where we published anonymously as the "Geeky Swedes." As the neighborhood grew in size and popularity, so did My Ballard, becoming one of the largest hyperlocal sites in the country. It became the anchor of a <a href="https://www.myballard.com/2009/08/26/my-ballard-seattle-times-form-partnership/">larger network</a> of neighborhood sites we called Next Door Media, and My Ballard and its cousin PhinneyWood won national journalism awards. But as a labor of love, it was difficult to maintain with our day jobs. So in 2020, Kate and I stepped aside and <a href="https://www.myballard.com/2020/09/29/beginning-of-a-new-era-for-my-ballard-and-how-you-can-help/">sold My Ballard</a> to its editor, Meghan Walker, for a dollar. We're extremely happy to see the site live on as a valuable community resource.`,
	},
	{
		title: 'Lost Remote',
		url: 'http://www.lostremote.com',
		date: '1997–2024',
		logo: lostRemoteLogo,
		description: `I launched Lost Remote as a newsletter in 1997, and it grew into one of the first blogs on the web. Focused on how technology was changing TV, Lost Remote covered the industry's collision with the internet. Then with the rise of social media, it narrowed its coverage to social TV. Lost Remote was highly influential among media executives, and Mediabistro <a href="https://www.adweek.com/lostremote/lost-remote-acquired-by-mediabistro-team/">acquired Lost Remote</a> in 2012. Two years later, Adweek bought Mediabistro, and Lost Remote continued publishing until 2024. Much of the archive still lives on at <a href="https://www.adweek.com/lostremote/?category=">Adweek.com</a>, with earlier snapshots preserved on the <a href="https://web.archive.org/web/20260000000000*/lostremote.com">Wayback Machine</a>.`,
	},
];

const writing: typeof companies = [
	{
		title: 'Factal blog',
		url: 'https://blog.factal.com',
		date: '2018–present',
		description: `I don't write as many of these posts anymore, but here are a few of my highlights:
<ul>
<li><a href="https://blog.factal.com/2024/09/the-rising-cost-of-misinformation-and-noise-in-risk-intelligence/">The rising cost of misinformation and noise in risk intelligence</a> (2024)</li>
<li><a href="https://blog.factal.com/2023/05/pentagon-non-explosion-is-an-unsettling-preview-of-ais-ability-to-disrupt-reality/">An unsettling preview of AI's ability to disrupt reality</a> (2023)</li>
<li><a href="https://blog.factal.com/2022/01/what-security-intelligence-teams-can-learn-from-emergency-doctors-to-accelerate-information-triage/">What security teams can learn about triage from emergency doctors</a> (2022)</li>
<li><a href="https://blog.factal.com/2019/02/how-information-vacuums-breed-misinformation/">How information vacuums breed misinformation</a> (2019)</li>
</ul>`,
	},
	{
		title: 'Medium (Breaking News)',
		url: 'https://medium.com/@breakingnews',
		date: '2015–2016',
		description: `The last few years' worth of Breaking News' announcements.`,
	},
	{
		title: 'Tumblr (Breaking News)',
		url: 'https://www.tumblr.com/breakingblog',
		date: '2010–2015',
		description: `I wrote a LOT about Breaking News' new features and innovations.`,
	},
	{
		title: 'My Ballard',
		url: 'https://www.myballard.com',
		date: '2007–2020',
		description: `My wife and I blogged about a Seattle neighborhood while we juggled two kids and our real jobs. Here are a couple of my <a href="https://www.myballard.com/2017/12/11/our-most-memorable-stories-on-my-ballards-10th-anniversary/">favorite stories</a>:
<ul>
<li><a href="https://www.myballard.com/2008/01/13/the-poster-lady-of-ballard-growth/">New building swallowing woman's home</a> (saga inspired Disney movie "Up")</li>
<li><a href="https://phinneywood.com/2009/10/2-alarm-fire-burning-on-85th/">3-alarm arson fire destroys Greenwood businesses</a> (won a national SPJ award)</li>
</ul>`,
	},
];

const press: typeof companies = [
	{
		title: "Monitoring global hotspots, Seattle media startup Factal lands key partnership to grow its business",
		url: 'https://www.geekwire.com/2024/risk-verification-startup-factal-raises-1m-in-new-partnership-with-global-security-firm/',
		source: 'GeekWire',
		date: '2024',
	},
	{
		title: "Prediction: The AI content flood",
		url: 'https://www.niemanlab.org/2022/12/the-ai-content-flood/',
		source: 'Nieman Lab',
		date: '2022',
	},
	{
		title: "Factal, which alerts companies of breaking news events, raises $3.3M after doubling revenue in 2020",
		url: 'https://www.geekwire.com/2021/factal-raises-3-3m-grow-platform-alerting-companies-breaking-news-events/',
		source: 'GeekWire',
		date: '2021',
	},
	{
		title: "Prediction: The year after a thousand earthquakes",
		url: 'https://www.niemanlab.org/2020/12/the-year-after-a-thousand-earthquakes/',
		source: 'Nieman Lab',
		date: '2021',
	},
	{
		title: "Prediction: Journalism as a technology service",
		url: 'https://www.niemanlab.org/2018/12/journalism-as-a-technology-service/',
		source: 'Nieman Lab',
		date: '2019',
	},
	{
		title: "Corporate news alert startup Factal launches 24/7 global service with core Breaking News team",
		url: 'https://www.geekwire.com/2018/corporate-news-alert-startup-factal-launches-24-7-global-service-core-breaking-news-team/',
		source: 'GeekWire',
		date: '2018',
	},
	{
		title: "I want bad news and I want it fast: That's the business model for Factal, a business-focused company",
		url: 'https://www.niemanlab.org/2018/08/i-want-bad-news-and-i-want-it-fast-thats-the-business-model-for-factal-a-business-focused-company-from-the-founders-of-breaking-news/',
		source: 'Nieman Lab',
		date: '2018',
	},
	{
		title: "Breaking News founders launch Factal, delivering real-time news and incident alerts to companies",
		url: 'https://www.geekwire.com/2018/breaking-news-app-founders-target-corporations-new-incident-alert-startup-factal/',
		source: 'GeekWire',
		date: '2018',
	},
	{
		title: "NBC shutting down Breaking News app, service",
		url: 'https://www.usatoday.com/story/tech/news/2016/12/08/nbc-shut-down-breaking-news-app-service/95149264/',
		source: 'USA Today',
		date: '2016',
	},
	{
		title: "When 9.4 million followers isn't enough: NBC News will shut down the Breaking News app on Dec. 31",
		url: 'https://www.niemanlab.org/2016/12/when-10-million-followers-isnt-enough-nbc-news-will-shut-down-the-breaking-news-app-on-dec-31/',
		source: 'Nieman Lab',
		date: '2016',
	},
	{
		title: "Breaking News wants you to use its app to share news tips with its editors — and other users",
		url: 'https://www.niemanlab.org/2016/06/breaking-news-wants-you-to-use-its-app-to-share-news-tips-with-its-editors-and-other-users/',
		source: 'Nieman Lab',
		date: '2016',
	},
	{
		title: "You can now get personalized Breaking News alerts on Slack",
		url: 'https://www.niemanlab.org/2016/04/you-can-now-get-personalized-breaking-news-alerts-on-slack/',
		source: 'Nieman Lab',
		date: '2016',
	},
	{
		title: "Prediction: The rise of frictionless video",
		url: 'https://www.niemanlab.org/2015/12/the-rise-of-frictionless-video/',
		source: 'Nieman Lab',
		date: '2016',
	},
	{
		title: "Push it: How Breaking News notifies users of news stories before they become big",
		url: 'https://www.niemanlab.org/2015/08/push-it-how-breaking-news-notifies-users-of-news-stories-before-they-become-big/',
		source: 'Nieman Lab',
		date: '2015',
	},
	{
		title: "Breaking News wants you to send news tips from the Apple Watch",
		url: 'https://www.theverge.com/2015/4/14/8410613/breaking-news-apple-watch-app',
		source: 'The Verge',
		date: '2015',
	},
	{
		title: "Geolocated News Is Going To Change The News Business",
		url: 'https://www.fastcompany.com/3032075/geolocated-news-is-going-to-change-the-news-business',
		source: 'Fast Company',
		date: '2014',
	},
	{
		title: "Maybe 'time saved' is a better metric to watch than 'time spent' on mobile",
		url: 'https://www.niemanlab.org/2014/11/maybe-time-saved-is-a-better-metric-to-watch-than-time-spent-on-mobile/',
		source: 'Nieman Lab',
		date: '2014',
	},
	{
		title: "The notification knows where you are: Breaking News debuts news alerts tied to your location",
		url: 'https://www.niemanlab.org/2014/06/the-notification-knows-where-you-are-breaking-news-debuts-news-alerts-tied-to-your-location/',
		source: 'Nieman Lab',
		date: '2014',
	},
	{
		title: "How @breakingnews keeps news junkies current in a crisis",
		url: 'https://www.theverge.com/2013/5/2/4289764/how-breakingnews-keeps-news-junkies-up-to-date',
		source: 'The Verge',
		date: '2013',
	},
	{
		title: "Here's how Breaking News reported truth during the Boston Marathon bombings",
		url: 'https://www.geekwire.com/2013/breaking-news-boston-marathon-bombings/',
		source: 'GeekWire',
		date: '2013',
	},
	{
		title: "BreakingNews.com Launches First-Ever Real-Time News App on Samsung SMART TV",
		url: 'https://www.nbcnews.com/id/wbna47078187',
		source: 'NBC News',
		date: '2012',
	},
	{
		title: "MSNBC.com's Breaking News traces info to its source",
		url: 'https://www.niemanlab.org/2011/04/msnbc-coms-breaking-news-traces-info-to-its-source/',
		source: 'Nieman Lab',
		date: '2011',
	},
	{
		title: "For The Trifecta: MSNBC Extends Its BreakingNews Brand To Facebook",
		url: 'https://techcrunch.com/2010/03/11/msnbc-breaking-news-facebook/',
		source: 'TechCrunch',
		date: '2010',
	},
];
// ─────────────────────────────────────────────────────────────────────────────
---

<BaseLayout
	title="Projects — Companies Founded by Cory Bergman"
	description="The companies Cory Bergman founded — Factal, Breaking News, My Ballard, Lost Remote — plus an index of his writing and the press coverage about him over the years."
	variant="sub"
	active="projects"
>
	<div class="page">
		<h1>Projects</h1>
		<p class="intro">
			Companies I've co-founded, products I've made and things I've published.
		</p>

		<h2 class="section">Companies</h2>
		{
			companies.length > 0 ? (
				<ul class="entries">
					{companies.map((item) => (
						<li class:list={['entry', item.logo && 'entry--logo']}>
							<div class="entry-head">
								{item.logo &&
									(item.url ? (
										<a href={item.url} class="entry-logo-link" aria-label={item.title}>
											<Image src={item.logo} alt={`${item.title} logo`} class="entry-logo" />
										</a>
									) : (
										<Image src={item.logo} alt={`${item.title} logo`} class="entry-logo" />
									))}
								<div class="entry-heading">
									{item.url ? (
										<a href={item.url} class="entry-title">
											{item.title}
										</a>
									) : (
										<span class="entry-title">{item.title}</span>
									)}
									{(item.source || item.date) && (
										<span class="entry-meta">
											{[item.source, item.date].filter(Boolean).join(' · ')}
										</span>
									)}
								</div>
							</div>
							{item.description && (
								<p class="entry-desc" set:html={item.description} />
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="soon">Coming soon.</p>
			)
		}

		<h2 class="section">Writing</h2>
		{
			writing.length > 0 ? (
				<ul class="entries">
					{writing.map((item) => (
						<li class="entry">
							<a href={item.url} class="entry-title">
								{item.title}
							</a>
							{(item.source || item.date) && (
								<span class="entry-meta">
									{[item.source, item.date].filter(Boolean).join(' · ')}
								</span>
							)}
							{item.description && (
								<div class="entry-desc" set:html={item.description} />
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="soon">Coming soon.</p>
			)
		}

		<h2 class="section">Press</h2>
		{
			press.length > 0 ? (
				<ul class="entries">
					{press.map((item) => (
						<li class="entry">
							<a href={item.url} class="entry-title">
								{item.title}
							</a>
							{(item.source || item.date) && (
								<span class="entry-meta">
									{[item.source, item.date].filter(Boolean).join(' · ')}
								</span>
							)}
							{item.description && (
								<p class="entry-desc" set:html={item.description} />
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="soon">Coming soon.</p>
			)
		}
	</div>
</BaseLayout>

<style>
	.page {
		max-width: var(--content-max);
		margin: 50px auto 0;
	}
	.page h1 {
		font-size: 34px;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 12px;
	}
	.intro {
		font-size: 16.5px;
		line-height: 1.7;
		color: var(--muted);
		margin: 0;
	}
	.section {
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #423f39;
		margin: 48px 0 20px;
	}
	.entries {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.entry-head {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.entry-logo-link {
		flex: none;
		display: inline-flex;
		border-radius: 9px;
		transition: opacity 0.15s ease;
	}
	.entry-logo-link:hover {
		opacity: 0.82;
	}
	.entry-logo {
		flex: none;
		display: block;
		width: 44px;
		height: 44px;
		border-radius: 9px;
		object-fit: cover;
		border: 1px solid rgba(31, 30, 27, 0.1);
	}
	.entry-heading {
		min-width: 0;
	}
	.entry--logo .entry-desc {
		margin-top: 12px;
	}
	.entry-title {
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
		line-height: 1.35;
	}
	.entry-title:hover {
		color: var(--pine-hover);
	}
	.entry-meta {
		display: block;
		font-size: 13px;
		color: var(--faint);
		margin-top: 3px;
	}
	.entry-desc {
		font-size: 15.5px;
		line-height: 1.6;
		color: var(--excerpt);
		margin: 6px 0 0;
	}
	.entry-desc :global(a) {
		color: var(--pine);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.entry-desc :global(ul) {
		margin: 8px 0 0;
		padding-left: 20px;
	}
	.entry-desc :global(li) {
		margin: 4px 0;
	}
	.soon {
		font-size: 15.5px;
		color: var(--faint);
		margin: 0;
	}
</style>
