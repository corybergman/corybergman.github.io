---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import speakingPhoto from '../assets/cory_osac_ai.jpeg';

// ── Fill these in ────────────────────────────────────────────────────────────
// Each engagement: { event, url, venue, date, description }
const engagements: Array<{
	event: string;
	url?: string;
	venue?: string;
	date?: string;
	description?: string;
}> = [
	{
		event: 'Workshop: A practical guide to verifying AI output',
		date: 'August 25th and 26th, 2026',
		description: `How do you know AI is right? This Factal training workshop will give security professionals practical tactics and real-world examples to verify AI responses. Learn about validating sources, spotting common errors and using AI to double-check its own work. Free to all attendees. Register for one of the two hour-long sessions here: <a href="https://us02web.zoom.us/webinar/register/WN_GEhfTZZ4QF-EXVwk_-nSZQ">August 25th</a> and <a href="https://us02web.zoom.us/webinar/register/WN_r7aPKsTNRv-UbChNj3VvLg#/registration">August 26th</a>.`,
	},
	{
		event: 'Global Security Briefing',
		url: 'https://www.factal.com/promo/globalsecuritybriefing/',
		date: 'every two weeks',
		description: `I make routine appearances in the Global Security Briefing, a webinar co-hosted by Factal and Emergent Risk International. The "GSB" began in the first days of COVID, and has since grown into the largest virtual event of its kind in the industry. Factal editors and ERI analysts dissect the biggest geopolitical events of the day, and I typically speak about AI. Make sure you <a href="https://www.factal.com/promo/globalsecuritybriefing/">register to attend</a> (it's free).`,
	},
];

// Each recent event: { title, date, context }
const recentEvents: Array<{
	title: string;
	date?: string;
	context?: string;
}> = [
	{ title: 'Emerging AI risks for CSOs', date: 'June 2026', context: 'keynote at ISMA 2026' },
	{ title: 'AI and disinformation in risk management', date: 'April 2026', context: 'regional OSAC keynote' },
	{ title: 'Strategic communication for security leaders', date: 'April 2026', context: 'SVSG Create fireside chat' },
	{ title: 'A practical guide to identifying AI videos', date: 'Feb 2026', context: 'Factal webinar' },
];
// ─────────────────────────────────────────────────────────────────────────────
---

<BaseLayout
	title="Speaking · Cory Bergman"
	description="Cory Bergman speaks on breaking news, AI, product and the future of real-time information. Booking and past engagements."
	variant="sub"
	active="speaking"
>
	<div class="page">
		<h1>Speaking</h1>
		<p class="pitch">
			I speak regularly with global security and risk audiences about AI,
			including hands-on training for Fortune 500 teams putting it into practice.
			I focus on practical applications and steer clear of hype and speculation.
			Recent talks include keynotes, fireside interviews, panels and bespoke
			training sessions.
		</p>
		<p class="pitch">
			Some of my upcoming events are listed below, and you can also check
			Factal's <a
				href="https://blog.factal.com/ai-training-resources-for-security-professionals/"
				>AI events page</a
			>. If you're organizing an event, please get in touch and learn more about
			my background on the <a href="/about">about page</a>.
		</p>

		<figure class="hero">
			<Image
				src={speakingPhoto}
				alt="Cory Bergman delivering an AI keynote to a packed room at a regional OSAC event"
				widths={[620, 940, 1240]}
				sizes="(max-width: 660px) 100vw, 620px"
				class="hero-img"
			/>
			<figcaption>Keynote about AI at OSAC's Annual Briefing in 2024</figcaption>
		</figure>

		<h2 class="section">Upcoming events</h2>
		{
			engagements.length > 0 ? (
				<ul class="entries">
					{engagements.map((item) => (
						<li class="entry">
							{item.url ? (
								<a href={item.url} class="entry-title">
									{item.event}
								</a>
							) : (
								<span class="entry-title">{item.event}</span>
							)}
							{(item.venue || item.date) && (
								<span class="entry-meta">
									{[item.venue, item.date].filter(Boolean).join(' · ')}
								</span>
							)}
							{item.description && (
								<p class="entry-desc" set:html={item.description} />
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="soon">Coming soon.</p>
			)
		}

		<h2 class="section">Recent events</h2>
		{
			recentEvents.length > 0 ? (
				<ul class="entries">
					{recentEvents.map((item) => (
						<li class="entry">
							<span class="entry-title">{item.title}</span>
							{(item.date || item.context) && (
								<span class="entry-meta">
									{[item.date, item.context].filter(Boolean).join(' · ')}
								</span>
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="soon">Coming soon.</p>
			)
		}
	</div>
</BaseLayout>

<style>
	.page {
		max-width: var(--content-max);
		margin: 50px auto 0;
	}
	.page h1 {
		font-size: 34px;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 20px;
	}
	.pitch {
		font-size: 16.5px;
		line-height: 1.75;
		color: var(--body);
		margin: 0 0 16px;
	}
	.pitch a {
		color: var(--pine);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.hero {
		margin: 28px 0 0;
	}
	.hero-img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 21 / 9;
		object-fit: cover;
		object-position: center 38%;
		border-radius: 6px;
		border: 1px solid var(--contour);
	}
	.hero figcaption {
		font-size: 13px;
		color: var(--faint);
		margin-top: 8px;
	}
	.section {
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #423f39;
		margin: 48px 0 20px;
	}
	.entries {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.entry-title {
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
		line-height: 1.35;
	}
	a.entry-title:hover {
		color: var(--pine-hover);
	}
	.entry-meta {
		display: block;
		font-size: 13px;
		color: var(--faint);
		margin-top: 3px;
	}
	.entry-desc {
		font-size: 15.5px;
		line-height: 1.6;
		color: var(--excerpt);
		margin: 6px 0 0;
	}
	.entry-desc :global(a) {
		color: var(--pine);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.soon {
		font-size: 15.5px;
		color: var(--faint);
		margin: 0;
	}
</style>
