---
import BaseLayout from '../layouts/BaseLayout.astro';

// ── Fill these in ────────────────────────────────────────────────────────────
// Each engagement: { event, url, venue, date, description }
const engagements: Array<{
	event: string;
	url?: string;
	venue?: string;
	date?: string;
	description?: string;
}> = [
	{
		event: 'Global Security Briefing',
		url: 'https://www.factal.com/promo/globalsecuritybriefing/',
		date: 'every two weeks',
		description: `I make routine appearances in the Global Security Briefing, a webinar co-hosted by Factal and Emergent Risk International. The "GSB" began in the first days of COVID, and has since grown into the largest virtual event of its kind in the industry. Factal editors and ERI analysts dissect the biggest geopolitical events of the day, and I typically speak about AI. Make sure you <a href="https://www.factal.com/promo/globalsecuritybriefing/">register to attend</a> (it's free).`,
	},
];
// ─────────────────────────────────────────────────────────────────────────────
---

<BaseLayout
	title="Speaking · Cory Bergman"
	description="Cory Bergman speaks on breaking news, AI, product and the future of real-time information. Booking and past engagements."
	variant="sub"
	active="speaking"
>
	<div class="page">
		<h1>Speaking</h1>
		<p class="pitch">
			I speak regularly to global security and risk audiences about AI, including
			hands-on training for teams putting it into practice. As a longtime journalist
			and product builder, I focus on practical applications and steer clear of hype
			and speculation. Talks include keynotes (OSAC and ISMA), fireside interviews
			(SVSG), panels (AIRIP and AR) and bespoke training sessions (Fortune 500s). If
			you're organizing an event, <a href="/about">get in touch</a>. You can
			also check Factal's <a
				href="https://blog.factal.com/ai-training-resources-for-security-professionals/"
				>AI events page</a
			>.
		</p>

		<h2 class="section">Upcoming events</h2>
		{
			engagements.length > 0 ? (
				<ul class="entries">
					{engagements.map((item) => (
						<li class="entry">
							{item.url ? (
								<a href={item.url} class="entry-title">
									{item.event}
								</a>
							) : (
								<span class="entry-title">{item.event}</span>
							)}
							{(item.venue || item.date) && (
								<span class="entry-meta">
									{[item.venue, item.date].filter(Boolean).join(' · ')}
								</span>
							)}
							{item.description && (
								<p class="entry-desc" set:html={item.description} />
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="soon">Coming soon.</p>
			)
		}
	</div>
</BaseLayout>

<style>
	.page {
		max-width: var(--content-max);
		margin: 72px auto 0;
	}
	.page h1 {
		font-size: 34px;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 20px;
	}
	.pitch {
		font-size: 16.5px;
		line-height: 1.75;
		color: var(--body);
		margin: 0 0 16px;
	}
	.pitch a {
		color: var(--pine);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.section {
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--pine-2);
		margin: 48px 0 20px;
	}
	.entries {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.entry-title {
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
		line-height: 1.35;
	}
	a.entry-title:hover {
		color: var(--pine-hover);
	}
	.entry-meta {
		display: block;
		font-size: 13px;
		color: var(--faint);
		margin-top: 3px;
	}
	.entry-desc {
		font-size: 15.5px;
		line-height: 1.6;
		color: var(--excerpt);
		margin: 6px 0 0;
	}
	.entry-desc :global(a) {
		color: var(--pine);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.soon {
		font-size: 15.5px;
		color: var(--faint);
		margin: 0;
	}
</style>
