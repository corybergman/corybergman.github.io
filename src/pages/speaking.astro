---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import speakingPhoto from '../assets/cory_osac_ai.jpeg';
import { pageCard } from '../lib/og-cards';
import { SOCIAL } from '../consts';
import speakingMasthead from '../assets/masthead-speaking.jpg';

// Speaking inquiries go to a dedicated Factal alias (not the blog Gmail alias
// the About page uses). The prefilled subject makes them easy to spot.
const SPEAKING_EMAIL = `mailto:speaking+cory@factal.com?subject=${encodeURIComponent('Speaking inquiry')}`;

// ── Fill these in ────────────────────────────────────────────────────────────
// Each engagement: { event, url, venue, date, description }
const engagements: Array<{
	event: string;
	url?: string;
	venue?: string;
	date?: string;
	description?: string;
}> = [
	{
		event:
			'How intel teams can validate, audit and trust their AI systems',
		venue: 'AIRIP 2026 Global Intelligence Forum',
		date: 'Sept 2026',
	},
	{
		event: 'Global Security Briefing',
		url: 'https://www.factal.com/promo/globalsecuritybriefing/',
		date: 'every two weeks',
		description: `I make routine appearances in the Global Security Briefing, a webinar co-hosted by Factal and Emergent Risk International. The "GSB" began in the first days of COVID, and has since grown into the largest virtual event of its kind in the industry. Factal editors and ERI analysts dissect the biggest geopolitical events of the day, and I typically speak about AI. Make sure you <a href="https://www.factal.com/promo/globalsecuritybriefing/">register to attend</a> (it's free).`,
	},
];

// Each recent event: { title, date, context }
const recentEvents: Array<{
	title: string;
	date?: string;
	context?: string;
}> = [
	{ title: 'Workshop: Practical guide to verifying AI', date: 'Aug 2026', context: 'Factal workshop' },
	{ title: 'Emerging AI risks for CSOs', date: 'June 2026', context: 'keynote at ISMA 2026' },
	{ title: 'AI and disinformation in risk management', date: 'April 2026', context: 'regional OSAC keynote' },
	{ title: 'Strategic communication for security leaders', date: 'April 2026', context: 'SVSG Create fireside chat' },
	{ title: 'Workshop: Practical guide to identifying AI videos', date: 'Feb 2026', context: 'Factal webinar' },
	{ title: 'Crisis planning', date: 'Sept 2025', context: 'OSAC Europe' },
	{ title: 'Safely using generative AI in security environments', date: 'June 2025', context: 'AIRIP Global Intelligence Forum' },
	{ title: 'Workshop: Practical introduction to AI in security', date: 'April 2025', context: 'webinar series' },
	{ title: 'Practical introduction to AI in security', date: 'March 2025', context: "Studio Security Chief's Association" },
];

// Speaking topics, shown between the photo and the events. Copy is Cory's.
const topics: Array<{ title: string; description: string }> = [
	{
		title: 'Putting AI to work in global security',
		description:
			'Practical tactics, tips and best practices to ensure teams are using AI securely.',
	},
	{
		title: 'Knowing what to trust when the stakes are high',
		description:
			'Spotting AI-generated media, checking sources and avoiding hidden errors.',
	},
	{
		title: 'Human judgment in an increasingly automated world',
		description:
			'Validating AI, evaluating security stacks and balancing AI and human work.',
	},
];
// ─────────────────────────────────────────────────────────────────────────────
---

<BaseLayout
	title="Speaking — Cory Bergman on practical AI for global security"
	description="Cory Bergman speaks to global security and risk teams about putting AI to work and knowing what to trust. Keynotes, panels and training workshops, plus upcoming and recent events."
	variant="sub"
	active="speaking"
	image={pageCard('speaking')}
	masthead={speakingMasthead}
>
	<div class="page">
		<h1>Speaking</h1>
		<figure class="hero">
			<Image
				src={speakingPhoto}
				alt="Cory Bergman delivering an AI keynote to a packed room at a regional OSAC event"
				widths={[620, 940, 1240]}
				sizes="(max-width: 660px) 100vw, 620px"
				class="hero-img"
			/>
			<figcaption>Keynote about AI at OSAC's Annual Briefing in 2024</figcaption>
		</figure>

		<p class="pitch">
			AI is changing how security and risk teams work. I help audiences explore
			what's possible, understand where things can go wrong and make better
			decisions when people's safety is at stake.
		</p>
		<p class="pitch">
			While most industry conversations about AI focus on the broader risk
			landscape, my talks combine real examples, practical methods and concrete
			takeaways. I offer keynotes, hands-on workshops, fireside conversations and
			team training, tailored to your audience and experience with AI.
		</p>


		<section class="topics">
			<h2 class="section first">Topics</h2>
			<ul class="entries">
				{
					topics.map((t) => (
						<li class="entry">
							<span class="entry-title">{t.title}</span>
							<p class="entry-desc">{t.description}</p>
						</li>
					))
				}
			</ul>
			<p class="cta">
				Planning an event? <a href={SPEAKING_EMAIL}>Email me →</a>
				<span class="cta-alt">
					You can read <a href="/about">more about my background</a> and find me
					on <a href={SOCIAL.linkedin}>LinkedIn</a>.
				</span>
			</p>
		</section>

		<h2 class="section">Upcoming speaking events</h2>
		{
			engagements.length > 0 ? (
				<ul class="entries">
					{engagements.map((item) => (
						<li class="entry">
							{item.url ? (
								<a href={item.url} class="entry-title">
									{item.event}
								</a>
							) : (
								<span class="entry-title">{item.event}</span>
							)}
							{(item.venue || item.date) && (
								<span class="entry-meta">
									{[item.venue, item.date].filter(Boolean).join(' · ')}
								</span>
							)}
							{item.description && (
								<p class="entry-desc" set:html={item.description} />
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="soon">Coming soon.</p>
			)
		}

		<h2 class="section">Recent speaking events</h2>
		{
			recentEvents.length > 0 ? (
				<ul class="entries">
					{recentEvents.map((item) => (
						<li class="entry">
							<span class="entry-title">{item.title}</span>
							{(item.date || item.context) && (
								<span class="entry-meta">
									{[item.date, item.context].filter(Boolean).join(' · ')}
								</span>
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="soon">Coming soon.</p>
			)
		}
	</div>
</BaseLayout>

<style>
	.page {
		max-width: var(--content-max);
		margin: 35px auto 0; /* matches the home hero top padding */
	}
	.page h1 {
		font-size: 34px;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 20px;
	}
	.pitch {
		font-size: 16.5px;
		line-height: 1.75;
		color: var(--body);
		margin: 0 0 16px;
	}
	.pitch a {
		color: var(--pine);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.hero {
		margin: 0 0 28px;
	}
	.hero-img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 21 / 9;
		object-fit: cover;
		object-position: center 38%;
		border-radius: 6px;
		border: 1px solid var(--contour);
	}
	.hero figcaption {
		font-size: 13px;
		color: var(--faint);
		margin-top: 8px;
	}
	/* Topics and the inquiry call-to-action share one card — the only enclosed
	   block on the page, matching the speaking card on the home page. */
	.topics {
		margin: 40px 0 0;
		padding: 28px 28px 24px;
		border: 1px solid var(--rule);
		border-radius: 6px;
		background: var(--card-bg);
	}
	.topics .section.first {
		margin-top: 0;
	}
	.cta {
		margin: 28px 0 0;
		padding: 20px 0 0;
		border-top: 1px solid var(--rule);
		font-size: 16px;
		line-height: 1.6;
		color: var(--ink);
	}
	.cta a {
		color: var(--pine);
	}
	.cta a:hover {
		color: var(--pine-hover);
	}
	.cta-alt {
		display: block;
		font-size: 14px;
		color: var(--muted);
		margin-top: 2px;
	}
	.section {
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--section-label);
		margin: 48px 0 20px;
	}
	.entries {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.entry-title {
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
		line-height: 1.35;
	}
	a.entry-title:hover {
		color: var(--pine-hover);
	}
	.entry-meta {
		display: block;
		font-size: 13px;
		color: var(--faint);
		margin-top: 3px;
	}
	.entry-desc {
		font-size: 15.5px;
		line-height: 1.6;
		color: var(--excerpt);
		margin: 6px 0 0;
	}
	.entry-desc :global(a) {
		color: var(--pine);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.soon {
		font-size: 15.5px;
		color: var(--faint);
		margin: 0;
	}
</style>
