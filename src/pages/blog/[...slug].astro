---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { postUrl } from '../../consts';

export async function getStaticPaths() {
	// Newest → oldest, so the "previous" post is the next-older neighbor. Prev
	// links span the whole feed, but this route only emits native posts —
	// migrated Tumblr posts are served from `/post/<id>/<slug>/` instead.
	const all = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return all
		.filter((post) => !post.data.tumblrId)
		.map((post) => {
			const older = all[all.indexOf(post) + 1];
			return {
				params: { slug: post.id },
				props: {
					post,
					prevPost: older
						? { href: postUrl(older), title: older.data.title }
						: null,
				},
			};
		});
}
type Props = {
	post: CollectionEntry<'blog'>;
	prevPost: { href: string; title: string } | null;
};

const { post, prevPost } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} id={post.id} prevPost={prevPost}>
	<Content />
</BlogPost>
