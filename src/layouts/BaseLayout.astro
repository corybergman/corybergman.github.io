---
import BaseHead from '../components/BaseHead.astro';
import TopoMasthead from '../components/TopoMasthead.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
	title: string;
	description: string;
	variant?: 'home' | 'sub';
	active?: 'writing' | 'about';
	canonical?: string;
	image?: string;
	article?: boolean;
	publishedDate?: Date;
	modifiedDate?: Date;
	tags?: string[];
}
const {
	title,
	description,
	variant = 'sub',
	active,
	canonical,
	image,
	article,
	publishedDate,
	modifiedDate,
	tags,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical={canonical}
			image={image}
			article={article}
			publishedDate={publishedDate}
			modifiedDate={modifiedDate}
			tags={tags}
		/>
	</head>
	<body>
		<div class="frame">
			<TopoMasthead variant={variant === 'home' ? 'tall' : 'short'} />
			<div class="frame-body">
				<SiteHeader variant={variant} active={active} />
				<slot />
			</div>
		</div>
	</body>
</html>
