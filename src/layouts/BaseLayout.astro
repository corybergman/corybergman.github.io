---
import BaseHead from '../components/BaseHead.astro';
import TopoMasthead from '../components/TopoMasthead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { NavKey } from '../components/SiteHeader.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	variant?: 'home' | 'sub';
	active?: NavKey;
	canonical?: string;
	image?: string;
	article?: boolean;
	publishedDate?: Date;
	modifiedDate?: Date;
	tags?: string[];
	/** Hide the footer's social row (see SiteFooter). */
	footerSocial?: boolean;
	/** Replace the masthead photo on this page (see TopoMasthead). */
	masthead?: ImageMetadata;
}
const {
	title,
	description,
	variant = 'sub',
	active,
	canonical,
	image,
	article,
	publishedDate,
	modifiedDate,
	tags,
	footerSocial = true,
	masthead,
} = Astro.props;
---

<!doctype html>
<!-- data-theme="dark" pins the site to the dark palette for everyone
     (Cory's call, 2026-09-08). Drop the attribute to go back to following
     the visitor's system setting. -->
<html lang="en" data-theme="dark">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical={canonical}
			image={image}
			article={article}
			publishedDate={publishedDate}
			modifiedDate={modifiedDate}
			tags={tags}
		/>
	</head>
	<body>
		<div class="frame">
			<TopoMasthead
				variant={variant === 'home' ? 'tall' : 'short'}
				image={masthead}
			/>
			<div class="frame-body">
				<SiteHeader active={active} />
				<slot />
				<SiteFooter social={footerSocial} />
			</div>
		</div>
	</body>
</html>
