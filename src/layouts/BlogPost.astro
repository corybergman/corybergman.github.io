---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SubscribeForm from '../components/SubscribeForm.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	prevPost?: { href: string; title: string } | null;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags = [],
	prevPost = null,
} = Astro.props;
---

<BaseLayout title={title} description={description} variant="sub" active="writing">
	<article class="post">
		<div class="date">
			<FormattedDate date={pubDate} />
			{
				updatedDate && (
					<span class="updated">
						{' '}· Updated <FormattedDate date={updatedDate} />
					</span>
				)
			}
		</div>
		<h1>{title}</h1>

		<div class="body">
			<slot />
		</div>

		{
			tags.length > 0 && (
				<div class="tags">
					{tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			)
		}

		<nav class="post-nav">
			{
				prevPost ? (
					<a href={prevPost.href}>← {prevPost.title}</a>
				) : (
					<span />
				)
			}
			<a href="/" class="all">All posts</a>
		</nav>

		<SubscribeForm variant="card" />
	</article>
</BaseLayout>

<style>
	.post {
		max-width: var(--content-max);
		margin: 72px auto 0;
	}
	.date {
		font-size: 13px;
		color: var(--faint);
		margin-bottom: 12px;
	}
	.updated {
		font-style: italic;
	}
	.post h1 {
		font-size: 34px;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin: 0 0 28px;
		text-wrap: pretty;
	}

	/* Post body — targets the rendered markdown. */
	.body {
		font-size: 16.5px;
		line-height: 1.75;
		color: var(--body);
	}
	.body :global(p) {
		margin: 0 0 22px;
	}
	.body :global(h2) {
		font-size: 22px;
		margin: 40px 0 14px;
	}
	.body :global(h3) {
		font-size: 18px;
		margin: 32px 0 12px;
	}
	.body :global(a) {
		color: var(--pine);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.body :global(blockquote) {
		border-left: 3px solid var(--pine);
		margin: 32px 0;
		padding: 4px 0 4px 24px;
		font-size: 18px;
		line-height: 1.6;
		color: var(--pine);
		font-style: italic;
	}
	.body :global(img) {
		border-radius: 6px;
	}
	.body :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--chip-bg);
		border-radius: 3px;
		padding: 1px 5px;
	}
	.body :global(pre) {
		background: var(--card-bg);
		border-radius: 6px;
		padding: 16px 20px;
		overflow-x: auto;
	}
	.body :global(pre code) {
		background: none;
		padding: 0;
	}

	.tags {
		display: flex;
		gap: 10px;
		margin-top: 36px;
		font-size: 13px;
		color: var(--pine-2);
	}
	.tag {
		background: var(--chip-bg);
		border-radius: 3px;
		padding: 4px 10px;
	}

	.post-nav {
		display: flex;
		justify-content: space-between;
		gap: 24px;
		border-top: 1px solid var(--rule);
		margin-top: 56px;
		padding-top: 24px;
		font-size: 14px;
		color: var(--muted);
	}
	.post-nav .all {
		color: var(--pine-2);
		font-weight: 500;
		flex-shrink: 0;
	}
</style>
